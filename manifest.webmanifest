{
  "name": "Karaoke",
  "short_name": "Karaoke",
  "description": "Play karaoke on the TV and add songs from your phone.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0b1a",
  "theme_color": "#0d0b1a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "TV screen", "url": "./tv.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Phone remote", "url": "./remote.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
